[init]
	defaultBranch = main
[user]
	name = Monti
	email = ooy.yoo@gmail.com
[branch]
  autosetuprebase = always
[core]
	editor = nvim
	quotepath = false
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
[merge]
  conflictstyle = diff3
[diff]
	tool = vimdiff
  colorMoved = default
[difftool]
	prompt = true
[alias]
  a = "!git status --short | fzf --multi | awk '{print $2}' | xargs git add"
  co = checkout
  br = branch
  ba = branch -a
  bm = branch --merged
  bn = branch --no-merged
  ci = commit
  ca = commit -a
  d = diff
  df = "!git hist | fzf --ansi | awk '{print $2}' | xargs -I {} git diff {}^ {}"
  dump = cat-file -p
  hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --date=relative --decorate --all --graph
  llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative
  ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
  pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
  open = "!gh browse"
  ru = "!git remote update"
  st = status
  type = cat-file -t
  find = "!f() { git log --pretty=format:\"%h %cd [%cn] %s%d\" --date=relative -S\"$@\" | fzf --ansi | awk '{print $1}' | xargs -I {} git diff {}^ {}; }; f"
  # edit conflicted file on merge
  edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; vim `f`"
  # add conflicted file on merge
  add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
	vd = difftool
[ghq]
  root = ~/.z/ghq
[gui]
	encoding = utf-8
[i18n]
	commitencoding = utf-8
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
