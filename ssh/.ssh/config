# Machine-local overrides, untracked (this repo is public — keep host
# addresses, ports and usernames out of it): ~/.ssh/config.d/*.conf
# ssh uses the first obtained value, so includes go first to win.
Include ~/.ssh/config.d/*.conf

#
# https://www.freecodecamp.org/news/manage-multiple-github-accounts-the-ssh-way-2dadc30ccaca/
# https://github.com/twtrubiks/Git-Tutorials/blob/master/Multiple_SSH_Keys_settings.md
#
# Remove SSH connection delay
# Host *
#   AddressFamily inet
# github - monti
Host github.com
  HostName github.com
  # IdentitiesOnly yes
  # User git
  AddKeysToAgent yes
  UseKeyChain yes
  IdentityFile ~/.ssh/id_ed25519
Host github-codecaba
  HostName github.com
  # IdentitiesOnly yes
  # User git
  AddKeysToAgent yes
  UseKeyChain yes
  IdentityFile ~/.ssh/codecaba
