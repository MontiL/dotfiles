#!/usr/bin/env python3

"""
用于将一张图片的颜色风格应用到另一张图片上，同时保留后者的内容和结构。
"""

import sys
from skimage import io, color, img_as_ubyte
import cv2
import numpy as np
from tqdm import tqdm


def color_transfer(source_img_path, target_img_path, output_img_path):
    # Load images
    img1 = io.imread(source_img_path)
    img2 = io.imread(target_img_path)

    # Convert images to LAB color space
    img1_lab = color.rgb2lab(img1)
    img2_lab = color.rgb2lab(img2)

    # Compute mean and standard deviation of the a* and b* channel (color channels in LAB color space) for each image
    mean_a_img1, std_a_img1 = np.mean(img1_lab[:, :, 1]), np.std(img1_lab[:, :, 1])
    mean_b_img1, std_b_img1 = np.mean(img1_lab[:, :, 2]), np.std(img1_lab[:, :, 2])

    mean_a_img2, std_a_img2 = np.mean(img2_lab[:, :, 1]), np.std(img2_lab[:, :, 1])
    mean_b_img2, std_b_img2 = np.mean(img2_lab[:, :, 2]), np.std(img2_lab[:, :, 2])

    # Perform color transfer
    for i in tqdm(range(img1_lab.shape[0]), desc="Processing"):
        img1_lab[i, :, 1] = (img1_lab[i, :, 1] - mean_a_img1) * (std_a_img2 / std_a_img1) + mean_a_img2
        img1_lab[i, :, 2] = (img1_lab[i, :, 2] - mean_b_img1) * (std_b_img2 / std_b_img1) + mean_b_img2

    # Clip values to stay in valid color range
    img1_lab[:, :, 1:3] = np.clip(img1_lab[:, :, 1:3], -128, 127)

    # Convert back to RGB color space
    img1_rgb = color.lab2rgb(img1_lab)
    img1_rgb = img_as_ubyte(img1_rgb)

    # Save the resulting image
    cv2.imwrite(output_img_path, cv2.cvtColor(img1_rgb, cv2.COLOR_RGB2BGR))


if __name__ == "__main__":
    if len(sys.argv) != 4:
        print(f"Usage: {sys.argv[0]} <source_img_path> <target_img_path> <output_img_path>")
        sys.exit(1)
    source_img_path = sys.argv[1]
    target_img_path = sys.argv[2]
    output_img_path = sys.argv[3]
    color_transfer(source_img_path, target_img_path, output_img_path)
